source "https://rubygems.org"

# Same versions GitHub Pages uses, so a local preview matches the live site.
# Needs Ruby 3.x (macOS's built-in Ruby 2.6 is too old) — see README.
gem "github-pages", group: :jekyll_plugins

# Standard-library parts that newer Ruby versions no longer bundle.
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
